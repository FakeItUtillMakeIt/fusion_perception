Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
  - Alpha: 0.35
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Name: Static Map
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Use Timestamp: false
    Enabled: true
  - Class: rviz_default_plugins/Image
    Name: Raw Image
    Topic:
      Depth: 5
      Reliability Policy: Best Effort
      Value: /camera/image_raw
  - Class: rviz_default_plugins/Image
    Name: Seg Vis
    Topic:
      Depth: 5
      Reliability Policy: Best Effort
      Value: /fp/sem_vis
    Enabled: true
  - Class: rviz_default_plugins/Image
    Name: Overlay
    Topic:
      Depth: 5
      Reliability Policy: Best Effort
      Value: /fp/overlay
    Enabled: true
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: RGB8
    Name: Labeled Points
    Topic:
      Depth: 5
      Reliability Policy: Best Effort
      Value: /fp/points_policy
    Enabled: false
  - Alpha: 0.7
    Autocompute Intensity Bounds: false
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: FlatColor
    Color: 200; 200; 200
    Name: Raw Cloud
    Topic:
      Depth: 5
      Reliability Policy: Best Effort
      Value: /lidar/points_raw
  - Alpha: 0.5
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Name: Traversability
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Value: /fp/traversability
    Enabled: false
  - Class: rviz_default_plugins/RobotModel
    Description Source: Topic
    Description Topic:
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: false
    Name: RobotModel
  - Class: rviz_default_plugins/TF
    Enabled: false
    Name: TF
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Obstacles
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fp_ob/markers
  - Alpha: 1.0
    Autocompute Intensity Bounds: false
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: FlatColor
    Color: 255;80;80
    Enabled: true
    Name: Non-Ground
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /fp_ob/points_non_ground
  Enabled: true
  Global Options:
    Background Color: 30; 30; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Yaw: 0.785
    Saved: null
