#!/usr/bin/env python3
"""仿真专用：读取 odom->base_link TF（=真值），发布为 /initialpose。
map 原点与 odom 原点重合（SLAM 从出生点开图）时，定位误差直接归零。"""
import math, sys
import rclpy
from rclpy.node import Node
import tf2_ros
from geometry_msgs.msg import PoseWithCovarianceStamped

def main():
    rclpy.init()
    n = Node('set_init_from_odom')
    buf = tf2_ros.Buffer()
    tf2_ros.TransformListener(buf, n)
    pub = n.create_publisher(PoseWithCovarianceStamped, '/initialpose', 1)
    t = None
    for _ in range(100):
        rclpy.spin_once(n, timeout_sec=0.1)
        try:
            t = buf.lookup_transform('odom', 'base_link', rclpy.time.Time())
            break
        except Exception:
            pass
    if t is None:
        print('ERROR: odom->base_link TF 不存在（仿真/EKF 没起？）', file=sys.stderr)
        return 1
    q = t.transform.rotation
    yaw = math.atan2(2*(q.w*q.z+q.x*q.y), 1-2*(q.z*q.z+q.y*q.y))
    msg = PoseWithCovarianceStamped()
    msg.header.frame_id = 'map'
    p = msg.pose.pose
    p.position.x = t.transform.translation.x
    p.position.y = t.transform.translation.y
    p.orientation.z = math.sin(yaw/2)
    p.orientation.w = math.cos(yaw/2)
    # 小协方差：让粒子集中在真值附近快速确认
    msg.pose.covariance[0] = 0.02
    msg.pose.covariance[7] = 0.02
    msg.pose.covariance[35] = 0.002
    for _ in range(10):
        pub.publish(msg)
        rclpy.spin_once(n, timeout_sec=0.1)
    print('initialpose 已发布: x=%.3f y=%.3f yaw=%.1f deg' % (p.position.x, p.position.y, math.degrees(yaw)))
    return 0

if __name__ == '__main__':
    sys.exit(main())
