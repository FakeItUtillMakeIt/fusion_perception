<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="factory_robot">

  <!-- ============ 基础参数 ============ -->
  <xacro:property name="wheel_r" value="0.075"/>
  <xacro:property name="wheel_w" value="0.05"/>

  <!-- [OPT] 传感器位置参数化，便于统一调整 -->
  <xacro:property name="imu_x"   value="0.0"/>
  <xacro:property name="imu_z"   value="0.30"/>
  <xacro:property name="lidar_x" value="0.25"/>
  <xacro:property name="lidar_z" value="0.45"/>
  <xacro:property name="cam_x"   value="0.30"/>
  <xacro:property name="cam_z"   value="0.65"/>
  <xacro:property name="base_top_z" value="0.30"/>  <!-- 底盘顶面 z -->

  <!-- ============ base_link：差速底盘 ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.6 0.5 0.25"/></geometry>
      <material name="mat_base"><color rgba="0.3 0.3 0.35 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.6 0.5 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.175"/>
      <mass value="18.0"/>
      <!-- [OPT] 惯量按盒体公式修正：Ixx=0.52, Iyy=0.63, Izz=0.91 -->
      <inertia ixx="0.52" ixy="0" ixz="0" iyy="0.63" iyz="0" izz="0.91"/>
    </inertial>
  </link>

  <!-- ============ 驱动轮 x2 ============ -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="mat_wheel"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.6"/>
        <inertia ixx="0.0011" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.0017"/>
      </inertial>
    </link>
    <!-- 关节：rpy=-pi/2 把圆柱轴从 z 转到父系 y；axis 0 0 1 在关节系即绕父系 y 滚动 -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0.12 ${y_reflect*0.3} ${wheel_r}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel prefix="left" y_reflect="1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <!-- [OPT] 驱动轮摩擦参数（P0：防止打滑/跑偏） -->
  <gazebo reference="left_wheel_link">
    <mu1>0.8</mu1><mu2>0.8</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>0.8</mu1><mu2>0.8</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <!-- ============ 后部两个从动轮：转向关节(绕z)+自由轮(绕y) ============ -->
  <xacro:macro name="rear_caster_wheel" params="prefix y_reflect">
    <link name="${prefix}_steer_link">
      <!-- [OPT] 加 visual，便于 RViz 观察转向 -->
      <visual>
        <geometry><cylinder radius="0.02" length="0.03"/></geometry>
        <material name="mat_steer"><color rgba="0.4 0.4 0.45 1.0"/></material>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <!-- [OPT] 转向关节放宽到 ±pi，避免被动转向卡边界；加 dynamics friction -->
    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steer_link"/>
      <origin xyz="-0.22 ${y_reflect*0.345} 0.078" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1.0" velocity="4.0" lower="-3.14" upper="3.14"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="${prefix}_wheel_mat"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0011"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="-0.03 0 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <!-- [OPT] 摩擦与驱动轮统一 kp/kd -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>0.5</mu1><mu2>0.5</mu2>
      <kp>1000000.0</kp><kd>100.0</kd>
    </gazebo>
  </xacro:macro>
  <xacro:rear_caster_wheel prefix="rear_left" y_reflect="1"/>
  <xacro:rear_caster_wheel prefix="rear_right" y_reflect="-1"/>

  <!-- ============ [OPT] 支撑杆（消除传感器悬空） ============ -->
  <xacro:macro name="mast" params="name x z_top radius">
    <link name="${name}_mast_link">
      <visual>
        <geometry><cylinder radius="${radius}" length="${z_top - base_top_z}"/></geometry>
        <material name="mat_mast"><color rgba="0.2 0.2 0.2 1.0"/></material>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_mast_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_mast_link"/>
      <!-- 支柱中心 = 底盘顶 + 长度/2 -->
      <origin xyz="${x} 0 ${base_top_z + (z_top - base_top_z)/2.0}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:mast name="lidar" x="${lidar_x}" z_top="${lidar_z}" radius="0.015"/>
  <xacro:mast name="camera" x="${cam_x}"  z_top="${cam_z}"  radius="0.012"/>

  <!-- ============ 3D LiDAR ============ -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="mat_lidar"><color rgba="0.05 0.05 0.1 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0004"/>
    </inertial>
  </link>
  <!-- [OPT] LiDAR 挂在支柱顶端 -->
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mast_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${(lidar_z - base_top_z)/2.0}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <!-- [OPT] 注释修正：3 线（-15..+15 度），供 pointcloud_to_laserscan 切片 -->
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>   <!-- [OPT] 180→360，1° 分辨率，利于 SLAM -->
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>17</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.2793</min_angle>
            <max_angle>0.2793</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/lidar/points_raw</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============ RGB 相机 ============ -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.06 0.08 0.05"/></geometry>
      <material name="mat_camera"><color rgba="0.1 0.1 0.15 1.0"/></material>
    </visual>
    <!-- [OPT] 加 collision，防撞 -->
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <!-- [OPT] 相机挂在支柱顶端 -->
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mast_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 ${(cam_z - base_top_z)/2.0}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0.1745 0</pose>
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <camera>
        <horizontal_fov>1.1408</horizontal_fov>
        <image>
          <width>640</width>
          <height>384</height>
          <format>R8G8B8</format>
        </image>
        <!-- [OPT] 补 distortion（全 0），camera_info 更完整 -->
        <distortion>
          <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
          <p1>0.0</p1><p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
      </camera>
      <plugin name="camera_ros" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=/camera/image_raw</remapping>
          <remapping>~/camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============ IMU ============ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <!-- [OPT] IMU 降到 z=0.30 贴顶面，靠近质心 -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} 0 ${imu_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_ros" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============ 关节状态发布 ============ -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=/joint_states</remapping>
      </ros>
      <update_rate>30.0</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>rear_left_steer_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_steer_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ============ 差速驱动插件 ============ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30.0</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.6</wheel_separation>
      <wheel_diameter>0.15</wheel_diameter>
      <max_wheel_torque>30.0</max_wheel_torque>        <!-- [OPT] 20→30，爬坡余量 -->
      <max_wheel_acceleration>1.5</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <covariance_x>0.05</covariance_x>
      <covariance_y>0.05</covariance_y>
      <covariance_yaw>0.02</covariance_yaw>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_joint_state>false</publish_joint_state>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>